{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true, // <-- Add this line
    "allowSyntheticDefaultImports": true // <-- Often paired with esModuleInterop
  },
  "include": [
    "src/**/*",
    "test/*.test.ts",
    "**/*.spec.ts"
  ]
}
